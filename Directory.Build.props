<Project>

  <!--
    Central version + compiler settings for all MatSplit projects.
    VersionMajor / VersionMinor are also consumed by the GitHub Actions
    docker build workflow to compose image tags.
  -->
  <PropertyGroup>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>1</VersionMinor>
  </PropertyGroup>

  <!-- Local/dev fallback version when no CI build number is supplied. -->
  <PropertyGroup Condition="'$(BuildNumber)' == ''">
    <BuildNumber>0</BuildNumber>
    <InformationalVersionSuffix>local-$([System.DateTime]::UtcNow.ToString('yyyyMMdd'))</InformationalVersionSuffix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(InformationalVersionSuffix)' == ''">
    <InformationalVersionSuffix>$(BuildNumber)-$([System.DateTime]::UtcNow.ToString('yyyyMMdd'))</InformationalVersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>$(VersionMajor).$(VersionMinor).$(BuildNumber)</VersionPrefix>
    <AssemblyVersion>$(VersionMajor).$(VersionMinor).0.0</AssemblyVersion>
    <FileVersion>$(VersionMajor).$(VersionMinor).$(BuildNumber).0</FileVersion>
    <InformationalVersion>$(VersionMajor).$(VersionMinor).$(InformationalVersionSuffix)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Company>MatSplit</Company>
    <Product>MatSplit</Product>
  </PropertyGroup>

</Project>
