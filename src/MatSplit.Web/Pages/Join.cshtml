@page
@model MatSplit.Web.Pages.JoinModel

@* The brand above (the layout of the pages without a menu) names the group; this is the card with what to do. *@
@if (Model.Group is null)
{
    <ms-card id="join-card" title="Beitritt nicht möglich" subtitle="Dieser Einladungslink kann leider nicht verwendet werden." icon="warning">
        <div class="mat-stack">
            <ms-alert id="join-error-text" tone="error" text="@Model.ErrorText"></ms-alert>

            <ms-button id="join-error-login" kind="primary" icon="user" label="Zur Anmeldung"
                       type="button" href="/Account/Login" full-width="true"></ms-button>
        </div>
    </ms-card>
}
else if (Model.IsSignedIn)
{
    <ms-card id="join-card" title="Gruppe beitreten" icon="users">
        <div class="mat-stack">
            <p>
                Du bist als <strong>@Model.SignedInName</strong> angemeldet. Tritt der Gruppe
                <strong>@Model.Group.Name</strong> direkt mit diesem Konto bei &#8211; dann bleiben
                alle deine Gruppen und Ausgaben zusammen.
            </p>

            <ms-form id="join-existing-form" handler="Existing">
                <ms-field id="jx-token" name="Token" type="hidden" value="@Model.Token"></ms-field>

                <ms-button-row id="jx-buttons" divider="false">
                    <ms-button id="jx-submit" kind="primary" icon="check" label="Jetzt beitreten"
                               full-width="true"></ms-button>
                    <ms-button id="jx-switch" kind="ghost" icon="logout" label="Anderes Konto verwenden"
                               type="button" href="/Account/Logout" full-width="true"></ms-button>
                </ms-button-row>
            </ms-form>
        </div>
    </ms-card>
}
else
{
    <ms-card id="join-card" title="Gruppe beitreten" icon="users">
        <div class="mat-stack">
            <p>
                Gib deinen Namen ein, um der Gruppe <strong>@Model.Group.Name</strong> beizutreten.
                Eine Anmeldung ist nicht erforderlich.
            </p>

            <ms-form id="join-form">
                <ms-field id="jf-name" for="Input.DisplayName" label="Dein Name" autofocus="true"
                          placeholder="Max Mustermann" autocomplete="nickname"></ms-field>
                <ms-field id="jf-token" name="Token" type="hidden" value="@Model.Token"></ms-field>

                <ms-button-row id="jf-buttons" divider="false">
                    <ms-button id="jf-submit" kind="primary" label="Beitreten & Loslegen"
                               full-width="true"></ms-button>
                </ms-button-row>
            </ms-form>

            <div class="mat-row ms-join-login">
                <span class="mat-muted">Du hast schon ein Konto?</span>
                <ms-button id="join-login" kind="ghost" size="sm" icon="user" label="Anmelden"
                           type="button" href="@Model.LoginUrl"></ms-button>
            </div>
        </div>
    </ms-card>
}
