@inject AppConfigService AppConfig
@{
    // The header bar (SHELL-08, SHELL-17): the burger for the drawer on a phone, the breadcrumb (on a phone the last two
    // items, so the parent page is always one tap away, also in an installed app that has no browser back button) and
    // at the right end the actions of the page, the main one in the accent colour and last. Where there are several
    // secondary actions they are icons from 900 px and one "more" button with a menu below it, so that the breadcrumb
    // keeps its room on a phone.
    var appName = ViewData.ReadString(LayoutKeys.AppName) ?? AppConfig.Current.AppName;
    var crumbs = ViewData.ReadBreadcrumb();
    var title = ViewData.ReadString(LayoutKeys.Title);

    var actions = ViewData.ReadHeaderActions();
    var secondary = actions.Where(action => !action.Primary).ToList();
    var primary = actions.Where(action => action.Primary).ToList();
    var folded = secondary.Count > 1;
}
<header class="mat-topbar">
    <button type="button" class="mat-burger" data-nav-toggle aria-label="Men&#252; &#246;ffnen" aria-controls="mat-nav" aria-expanded="false">
        <ms-icon name="menu"></ms-icon>
    </button>
    <nav class="mat-crumbs" aria-label="Breadcrumb">
        <ol>
            @if (crumbs.Count == 0)
            {
                <li aria-current="page">@(string.IsNullOrWhiteSpace(title) ? appName : title)</li>
            }
            else
            {
                <li><a href="/" aria-label="Start"><ms-icon name="home"></ms-icon></a></li>
                @for (var index = 0; index < crumbs.Count; index++)
                {
                    var item = crumbs[index];
                    var isLast = index == crumbs.Count - 1;

                    if (isLast || string.IsNullOrWhiteSpace(item.Url))
                    {
                        <li aria-current="page">@item.Text</li>
                    }
                    else
                    {
                        <li><a href="@item.Url">@item.Text</a></li>
                    }
                }
            }
        </ol>
    </nav>
    @if (actions.Count > 0)
    {
        <div class="mat-topbar__actions">
            @foreach (var action in secondary)
            {
                <a class="mat-btn mat-btn--ghost mat-btn--icon @(folded ? "mat-d-none mat-d-md-inline-flex" : string.Empty)" href="@action.Url"
                   aria-label="@action.Label" data-tip="@action.Label">
                    <ms-icon name="@action.Icon"></ms-icon>
                </a>
            }
            @if (folded)
            {
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-d-md-none" data-menu-toggle="header-actions-menu"
                        data-menu-place="bottom" aria-haspopup="menu" aria-expanded="false" aria-label="Weitere Aktionen">
                    <ms-icon name="more-horizontal"></ms-icon>
                </button>
            }
            @foreach (var action in primary)
            {
                <a class="mat-btn mat-btn--primary mat-btn--icon" href="@action.Url"
                   aria-label="@action.Label" data-tip="@action.Label">
                    <ms-icon name="@action.Icon"></ms-icon>
                </a>
            }
        </div>
    }
</header>
