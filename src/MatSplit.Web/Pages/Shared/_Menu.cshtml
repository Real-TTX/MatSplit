@inject AppConfigService AppConfig
@{
    // The menu of the shell (SHELL-01 .. SHELL-07): the brand, the groups of the user as items with a small plus at the
    // heading of the list (the list the user can change), the administration for admins, and at the foot the user, the
    // 3-state theme button and the version.
    var appName = ViewData.ReadString(LayoutKeys.AppName) ?? AppConfig.Current.AppName;
    var path = ViewContext.HttpContext.Request.Path.Value ?? "/";
    path = path.Length > 1 ? path.TrimEnd('/') : "/";
    var groups = ViewData.ReadMenuGroups();
    var activeGroupId = ViewData.ReadActiveGroupId();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = ViewData.ReadFlag(LayoutKeys.IsAdmin) || User.IsInRole(nameof(UserRole.Admin));
    // Link guests (Anonymous role) join by invite and may not create groups.
    var canCreateGroup = isAuthenticated && !User.IsInRole(nameof(UserRole.Anonymous));
    var displayName = ViewData.ReadString(LayoutKeys.CurrentUserName) ?? User.Identity?.Name ?? "Gast";
    var role = isAdmin ? "Administrator" : User.IsInRole(nameof(UserRole.Anonymous)) ? "Gast" : "Mitglied";
    var themeSaveUrl = ViewData.ReadString("ThemeSaveUrl")
        ?? (isAuthenticated ? MatSplit.Web.Pages.Account.ProfileModel.ThemeSaveUrl : null);

    bool IsPath(string target)
        => path.Equals(target, StringComparison.OrdinalIgnoreCase)
        || path.StartsWith(target + "/", StringComparison.OrdinalIgnoreCase);

    string ItemClass(bool active) => active ? "mat-nav__item is-active" : "mat-nav__item";
    string? Current(bool active) => active ? "page" : null;

    var groupsOverviewActive = path.Equals("/Groups", StringComparison.OrdinalIgnoreCase) && activeGroupId is null;
}
<aside class="mat-nav" id="mat-nav">
    <div class="mat-nav__brand">
        <a href="/" aria-label="@appName Startseite">
            <span class="mat-logo" role="img" aria-label="@appName"><svg class="mat-icon" aria-hidden="true" focusable="false"><use href="#ms-i-logo"></use></svg></span>
            <span>
                <span class="mat-nav__name">@appName</span>
                <span class="mat-nav__tagline">Gemeinsame Ausgaben</span>
            </span>
        </a>
        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-nav__close" data-nav-close aria-label="Men&#252; schlie&#223;en">
            <ms-icon name="x"></ms-icon>
        </button>
    </div>

    <nav class="mat-nav__scroll" aria-label="Hauptnavigation">
        <ul class="mat-nav__list">
            @if (isAuthenticated)
            {
                <li>
                    <a class="@ItemClass(groupsOverviewActive)" href="/Groups" aria-current="@Current(groupsOverviewActive)">
                        <ms-icon name="home"></ms-icon><span>&#220;bersicht</span>
                    </a>
                </li>

                @if (canCreateGroup)
                {
                    <li class="mat-nav__group mat-nav__group--action" role="presentation">
                        <span class="mat-nav__group-title">Gruppen</span>
                        <a class="mat-nav__group-action" href="/Groups/Edit" aria-label="Neue Gruppe anlegen" title="Neue Gruppe anlegen">
                            <ms-icon name="plus"></ms-icon>
                        </a>
                    </li>
                }
                else if (groups.Count > 0)
                {
                    <li class="mat-nav__group" role="presentation">Gruppen</li>
                }

                @foreach (var group in groups)
                {
                    var isActiveGroup = activeGroupId == group.Id;
                    <li>
                        <a class="@ItemClass(isActiveGroup)" href="/Groups/Details?groupId=@group.Id" aria-current="@Current(isActiveGroup)">
                            <ms-icon name="users"></ms-icon><span>@group.Name</span>
                        </a>
                    </li>
                }
            }

            @if (isAdmin)
            {
                <li class="mat-nav__group" role="presentation">Administration</li>
                <li>
                    <a class="@ItemClass(path.Equals("/Admin", StringComparison.OrdinalIgnoreCase))" href="/Admin">
                        <ms-icon name="admin"></ms-icon><span>&#220;bersicht</span>
                    </a>
                </li>
                <li>
                    <a class="@ItemClass(IsPath("/Admin/Users"))" href="/Admin/Users">
                        <ms-icon name="users"></ms-icon><span>Benutzer</span>
                    </a>
                </li>
                <li>
                    <a class="@ItemClass(IsPath("/Admin/Groups"))" href="/Admin/Groups">
                        <ms-icon name="group"></ms-icon><span>Gruppen</span>
                    </a>
                </li>
                <li>
                    <a class="@ItemClass(IsPath("/Admin/Settings"))" href="/Admin/Settings">
                        <ms-icon name="settings"></ms-icon><span>Einstellungen</span>
                    </a>
                </li>
            }
        </ul>
    </nav>

    <div class="mat-nav__foot">
        <div class="mat-nav__account">
            @if (isAuthenticated)
            {
                <button type="button" class="mat-user" data-menu-toggle="user-menu" data-menu-place="top" aria-haspopup="menu" aria-expanded="false">
                    <span class="mat-avatar" aria-hidden="true">@MsAvatar.Initials(displayName)</span>
                    <span class="mat-user__text">
                        <span class="mat-user__name">@displayName</span>
                        <span class="mat-user__role">@role</span>
                    </span>
                    <ms-icon name="chevron-up" class="mat-user__chev"></ms-icon>
                </button>
            }
            else
            {
                <a class="mat-user" href="/Account/Login">
                    <span class="mat-avatar" aria-hidden="true"><ms-icon name="user"></ms-icon></span>
                    <span class="mat-user__text"><span class="mat-user__name">Anmelden</span></span>
                </a>
            }
            <button type="button" class="mat-theme" data-theme-toggle data-theme-state="system"
                    data-theme-save-url="@themeSaveUrl"
                    aria-label="Design: System. Klicken f&#252;r Hell." title="Design: System. Klicken f&#252;r Hell.">
                <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
                <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
                <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
            </button>
        </div>
        <div class="mat-nav__version">@appName @MsUi.Version</div>
    </div>
</aside>
@if (!string.IsNullOrEmpty(themeSaveUrl))
{
    @* matui.js posts the theme with this token; a page without a form would otherwise have none and the handler would answer 400. *@
    @Html.AntiForgeryToken()
}
