@page
@model MatSplit.Web.Pages.Groups.IndexModel
@* Creation is the prominent "Neue Gruppe" button under the list (desktop AND mobile) and the plus at the
   heading of the groups in the menu, so this page sets no "+" in the header bar. *@

<ms-list id="groups">

    <ms-toolbar id="groups-tools" action="/Groups" reset-url="/Groups">
        <ms-field id="groups-search" name="search" type="search" label="Suche"
                  value="@Model.Search" placeholder="Name oder Beschreibung"></ms-field>
        <ms-field id="groups-sort" name="sort" type="select" label="Sortierung"
                  items="Model.SortOptions"></ms-field>
    </ms-toolbar>

    @if (Model.Result.TotalCount > 0)
    {
        @* The groups are cards that are links: name, the own saldo, the members and how much was spent
           compared with the group that spent the most. *@
        <div class="mat-gallery ms-grouplist" id="groups-cards">
            @foreach (var group in Model.Result.Items)
            {
                var spentPct = Model.MaxExpensesCents > 0
                    ? Math.Clamp((int)Math.Round(group.TotalExpensesCents * 100d / Model.MaxExpensesCents), 0, 100)
                    : 0;

                <a class="mat-card ms-grouplist__item" href="@($"/Groups/Details?groupId={group.Id}")">
                    <span class="ms-grouplist__top">
                        <span class="ms-grouplist__name">@group.Name</span>
                        <span class="ms-grouplist__balance">
                            <span class="ms-grouplist__balance-label">Saldo</span>
                            <ms-money cents="@group.OwnBalanceCents" currency="@group.Currency" show-sign="true"></ms-money>
                        </span>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(group.Description))
                    {
                        <span class="mat-muted ms-grouplist__description">@group.Description</span>
                    }
                    <span class="mat-muted">
                        @group.MemberCount @(group.MemberCount == 1 ? "Mitglied" : "Mitglieder")
                        @if (group.ShareTotal != group.MemberCount)
                        {
                            <span class="mat-tag">@group.ShareTotal Anteile</span>
                        }
                    </span>
                    <div class="mat-meter" role="progressbar" aria-valuenow="@spentPct" aria-valuemin="0" aria-valuemax="100"
                         aria-label="Anteil an den Ausgaben der größten Gruppe">
                        <div class="mat-meter__fill" data-value="@spentPct"></div>
                    </div>
                    <span class="ms-grouplist__spent">
                        <ms-money cents="@group.TotalExpensesCents" currency="@group.Currency"></ms-money> ausgegeben
                    </span>
                    <span class="ms-grouplist__spent">
                        Letzte Aktivität @MatSplit.Web.Pages.Groups.IndexModel.FormatMoment(group.LastActivityUtc)
                    </span>
                </a>
            }
        </div>
    }

    @if (Model.Result.TotalCount == 0)
    {
        <ms-empty-state id="groups-empty"
                        title="@(string.IsNullOrWhiteSpace(Model.Search) ? "Noch keine Gruppe" : "Keine Treffer")"
                        text="@(string.IsNullOrWhiteSpace(Model.Search) ? "Lege eine Gruppe an, lade deine Leute ein und tracke die erste Ausgabe." : "Zu deiner Suche passt keine Gruppe. Setze den Filter zurück.")"
                        icon="group"
                        action-url="@(Model.CanCreateGroup && string.IsNullOrWhiteSpace(Model.Search) ? "/Groups/Edit" : null)"
                        action-label="Neue Gruppe"></ms-empty-state>
    }

    <ms-pagination id="groups-pager"
                   page="@Model.Result.Page"
                   page-size="@Model.Result.PageSize"
                   total-count="@Model.Result.TotalCount"
                   page-url="@Model.PageUrl"></ms-pagination>

    @if (Model.CanCreateGroup)
    {
        <ms-actions id="groups-actions">
            <ms-button id="groups-new" kind="primary" icon="plus" label="Neue Gruppe" href="/Groups/Edit"></ms-button>
        </ms-actions>
    }
</ms-list>
