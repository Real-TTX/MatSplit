@page
@model MatSplit.Web.Pages.Groups.MembersModel

<partial name="_GroupNav" model="new MatSplit.Web.Pages.Groups.GroupNav(Model.GroupId, MatSplit.Web.Pages.Groups.GroupNav.Members, Model.CanManage)" />

<ms-list id="members" title="Mitglieder" subtitle="Anteilsfaktoren, Rechte und Zugehörigkeit"
         icon="users" count="@Model.Result.TotalCount">

    <ms-toolbar id="members-filter"
                action="/Groups/Members"
                reset-url="@($"/Groups/Members?groupId={Model.GroupId}")"
                preserve="groupId"
                auto-submit-text="true">
        <ms-field id="members-search" name="search" type="search" label="Suche"
                  value="@Model.Search" placeholder="Name oder E-Mail"></ms-field>
        <ms-field id="members-sort" name="sort" type="select" label="Sortierung"
                  items="Model.SortOptions"></ms-field>
    </ms-toolbar>

    @if (!Model.CanManage)
    {
        <ms-alert id="members-readonly" tone="info"
                  text="Nur Gruppen-Administratoren können Mitglieder ändern oder entfernen."></ms-alert>
    }

    <ms-table id="members-table" caption="Mitglieder der Gruppe">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col" class="ms-num">Anteilsfaktor</th>
                <th scope="col">Verwaltung</th>
                <th scope="col">Beigetreten</th>
                <th scope="col"><span class="ms-visually-hidden">Aktionen</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model.Result.Items)
            {
                var prefix = $"member-{member.UserId}";
                var editUrl = $"/Groups/MemberEdit?groupId={Model.GroupId}&userId={member.UserId}";
                <tr>
                    <td data-label="Name">
                        @member.DisplayName
                        @if (member.IsCurrentUser)
                        {
                            <span class="ms-chip">Du</span>
                        }
                        @if (member.IsAnonymous)
                        {
                            <span class="ms-chip">Anonym</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(member.Email))
                        {
                            <span class="ms-muted">@member.Email</span>
                        }
                    </td>
                    <td data-label="Anteilsfaktor" class="ms-num">@member.ShareFactor</td>
                    <td data-label="Verwaltung">
                        @if (member.IsGroupAdmin)
                        {
                            <span class="ms-chip">Gruppen-Admin</span>
                        }
                        else
                        {
                            <span class="ms-muted">Mitglied</span>
                        }
                    </td>
                    <td data-label="Beigetreten">
                        @MatSplit.Web.Pages.Groups.MembersModel.FormatMoment(member.JoinedUtc)
                    </td>
                    <td data-label="Aktionen">
                        <div class="ms-table__rowactions">
                            @if (Model.CanManage)
                            {
                                <ms-button id="@($"{prefix}-edit")" kind="ghost" size="sm"
                                           icon="edit" icon-only="true" label="Mitgliedschaft bearbeiten"
                                           href="@editUrl"></ms-button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </ms-table>

    @if (Model.Result.TotalCount == 0)
    {
        <ms-empty-state id="members-empty"
                        title="@(string.IsNullOrWhiteSpace(Model.Search) ? "Noch keine Mitglieder" : "Keine Treffer")"
                        text="Teile den Einladungslink oder nimm einen bestehenden Benutzer auf."
                        icon="users"
                        action-url="@(Model.CanManage ? $"/Groups/MemberEdit?groupId={Model.GroupId}" : null)"
                        action-label="Mitglied hinzufügen"></ms-empty-state>
    }

    <ms-pagination id="members-pager"
                   page="@Model.Result.Page"
                   page-size="@Model.Result.PageSize"
                   total-count="@Model.Result.TotalCount"
                   page-url="@Model.PageUrl"></ms-pagination>

    <ms-actions id="members-actions">
        @if (Model.CanManage)
        {
            <ms-button id="members-add" kind="primary" icon="plus" label="Mitglied hinzufügen"
                       href="@($"/Groups/MemberEdit?groupId={Model.GroupId}")"></ms-button>
        }
        <ms-button id="members-overview" kind="secondary" icon="info" label="Zur Übersicht"
                   href="@($"/Groups/Details?groupId={Model.GroupId}")"></ms-button>
        <ms-button id="members-balance" kind="secondary" icon="balance" label="Kontostand"
                   href="@($"/Groups/Balance?groupId={Model.GroupId}")"></ms-button>
    </ms-actions>
</ms-list>

<ms-card id="member-invite" title="Einladungslink" icon="link" tone="accent"
         subtitle="Beitritt ohne Konto – ideal für Urlaubsbekanntschaften">
    @if (!Model.AllowAnonymousJoin)
    {
        <ms-alert id="member-invite-off" tone="warning"
                  text="Anonymer Beitritt ist in den Einstellungen deaktiviert. Der Link funktioniert erst wieder, wenn ein Administrator ihn global erlaubt."></ms-alert>
    }
    else if (!Model.Group.InviteEnabled)
    {
        <ms-alert id="member-invite-disabled" tone="warning"
                  text="Die Einladung ist für diese Gruppe deaktiviert. Der Link unten funktioniert erst nach dem Aktivieren."></ms-alert>
    }

    <ms-field id="inv-url" type="static" label="Link zum Teilen" value="@Model.InviteUrl"
              hint="Zeige den Link groß auf dem Bildschirm, dann kann er direkt abfotografiert oder per Messenger weitergegeben werden."></ms-field>

    <div class="ms-row">
        <ms-button id="inv-whatsapp" kind="primary" icon="whatsapp" label="Per WhatsApp teilen"
                   href="@Model.WhatsAppUrl" target="_blank"></ms-button>
        <ms-button id="inv-share" kind="secondary" icon="share" label="Teilen" type="button"
                   data-ms-share="true" data-ms-share-url="@Model.InviteUrl"
                   data-ms-share-title="MatSplit-Einladung" data-ms-share-text="@Model.ShareText"></ms-button>
        <ms-button id="inv-copy" kind="secondary" icon="copy" label="Kopieren" type="button"
                   data-ms-copy="#inv-url"></ms-button>
        <ms-button id="inv-open" kind="ghost" icon="link" label="Link öffnen"
                   href="@Model.InviteUrl" target="_blank"></ms-button>
    </div>

    @if (Model.CanManage)
    {
        <ms-form id="inv-toggle-form" action="@Model.SelfUrl" handler="ToggleInvite"
                 validation-summary="none" no-validate="true">
            <ms-field id="inv-toggle-group" name="groupId" type="hidden" value="@Model.GroupId"></ms-field>
            <div class="ms-row">
                <ms-button id="inv-toggle" kind="secondary"
                           icon="@(Model.Group.InviteEnabled ? "close" : "check")"
                           label="@(Model.Group.InviteEnabled ? "Einladung deaktivieren" : "Einladung aktivieren")"
                           name="enabled" value="@(Model.Group.InviteEnabled ? "false" : "true")"></ms-button>
            </div>
        </ms-form>

        <ms-form id="inv-new-form" action="@Model.SelfUrl" handler="RegenerateInvite"
                 validation-summary="none" no-validate="true">
            <ms-field id="inv-new-group" name="groupId" type="hidden" value="@Model.GroupId"></ms-field>
            <div class="ms-row">
                <ms-button id="inv-new" kind="danger" icon="link" label="Neuen Link erzeugen"
                           confirm="Neuen Einladungslink erzeugen? Der bisherige Link wird sofort ungültig."></ms-button>
            </div>
        </ms-form>
    }
</ms-card>
