@page
@using MatSplit.Web.Services.Models
@model MatSplit.Web.Pages.Groups.DetailsModel
@{
    var currency = Model.Group.Currency;
    var myBalanceCents = Model.MyBalance?.BalanceCents ?? 0;
    var myOwedCents = Model.MyBalance?.OwedCents ?? 0;
    var myUserId = Model.MyBalance?.UserId ?? 0;
    var balanceUrl = $"/Groups/Balance?groupId={Model.GroupId}";
    var expenseEditUrl = $"/Groups/Expenses/Edit?groupId={Model.GroupId}";
    var shareUrl = $"/Groups/Share?groupId={Model.GroupId}";
    var historyUrl = $"/Groups/History?groupId={Model.GroupId}";
    var memberEditUrl = $"/Groups/MemberEdit?groupId={Model.GroupId}";
    var editUrl = $"/Groups/Edit?id={Model.GroupId}";
    var transactionsActive = Model.ActiveTab == MatSplit.Web.Pages.Groups.DetailsModel.TabTransactions;
    var membersActive = Model.ActiveTab == MatSplit.Web.Pages.Groups.DetailsModel.TabMembers;
}

@* Large orange balance hero. Tapping it opens the Kontostand sub-page
   (/Groups/Balance) with the open settlements and per-member balances. *@
<a class="ms-balance-hero ms-balance-hero--link" id="group-balance-hero"
   href="@balanceUrl" aria-label="Kontostand im Detail ansehen">
    <span class="ms-balance-hero__label">Kontostand</span>
    <span class="ms-balance-hero__amount">
        <ms-money cents="@myBalanceCents" currency="@currency" show-sign="true"></ms-money>
    </span>
    <span class="ms-balance-hero__share">
        Dein Anteil <strong><ms-money cents="@myOwedCents" currency="@currency"></ms-money></strong>
        von <ms-money cents="@Model.Balance.TotalExpensesCents" currency="@currency"></ms-money>
    </span>
    <span class="ms-balance-hero__chart">
        <svg viewBox="0 0 108 46" aria-hidden="true" focusable="false">
            <path d="@Model.BalanceSparkline()" />
        </svg>
    </span>
</a>

@* Pill tab bar: tabs left, "Gruppe verwalten" gear right (server-side tabs via ?tab=). *@
<nav class="group-tabs" aria-label="Gruppenbereiche">
    <a id="group-tab-transaktionen"
       class="group-tab@(transactionsActive ? " is-active" : string.Empty)"
       href="@Model.TabUrl(MatSplit.Web.Pages.Groups.DetailsModel.TabTransactions)"
       aria-current="@(transactionsActive ? "page" : null)">
        <ms-icon name="expense" size="18"></ms-icon>
        <span>Transaktionen</span>
    </a>
    <a id="group-tab-mitglieder"
       class="group-tab@(membersActive ? " is-active" : string.Empty)"
       href="@Model.TabUrl(MatSplit.Web.Pages.Groups.DetailsModel.TabMembers)"
       aria-current="@(membersActive ? "page" : null)">
        <ms-icon name="users" size="18"></ms-icon>
        <span>Mitglieder (@Model.Members.Count)</span>
    </a>
    <span class="group-tabs__tools">
        <a id="group-tab-history" class="group-tabs__gear" href="@historyUrl"
           aria-label="Historie" title="Historie">
            <ms-icon name="history" size="20"></ms-icon>
        </a>
        @if (Model.CanInvite)
        {
            <a id="group-tab-share" class="group-tabs__gear" href="@shareUrl"
               aria-label="Einladung teilen" title="Einladung teilen">
                <ms-icon name="share" size="20"></ms-icon>
            </a>
        }
        @if (Model.CanManage)
        {
            <a id="group-tab-settings" class="group-tabs__gear" href="@editUrl"
               aria-label="Gruppe verwalten" title="Gruppe verwalten">
                <ms-icon name="cog" size="20"></ms-icon>
            </a>
        }
    </span>
</nav>

@if (transactionsActive)
{
    <ms-card id="group-transactions">
        @{
            var typeAll = MatSplit.Web.Pages.Groups.DetailsModel.TypeAll;
            var typeExpenses = MatSplit.Web.Pages.Groups.DetailsModel.TypeExpenses;
            var typePayments = MatSplit.Web.Pages.Groups.DetailsModel.TypePayments;
        }
        <div class="txn-toolbar">
            <div class="txn-filter" role="tablist" aria-label="Nach Typ filtern">
                <a class="txn-filter__pill@(Model.ActiveType == typeAll ? " is-active" : string.Empty)"
                   href="@Model.TypeUrl(typeAll)">Alle</a>
                <a class="txn-filter__pill@(Model.ActiveType == typeExpenses ? " is-active" : string.Empty)"
                   href="@Model.TypeUrl(typeExpenses)">Ausgaben</a>
                <a class="txn-filter__pill@(Model.ActiveType == typePayments ? " is-active" : string.Empty)"
                   href="@Model.TypeUrl(typePayments)">Zahlungen</a>
            </div>

            @* Primary action goes straight to a new expense (the common case);
               payments are recorded from the Kontostand page. *@
            <ms-button id="txn-new" kind="primary" icon="plus" label="Neue Ausgabe"
                       href="@expenseEditUrl"></ms-button>
        </div>

        @if (Model.Transactions.IsEmpty)
        {
            <ms-empty-state id="group-transactions-empty" title="Noch keine Transaktionen"
                            text="Erfasse die erste Ausgabe oder Zahlung, damit die Abrechnung starten kann."
                            icon="expense"
                            action-url="@expenseEditUrl"
                            action-label="Ausgabe erfassen"></ms-empty-state>
        }
        else
        {
            <div class="txn-list">
                @foreach (var row in Model.Transactions.Items)
                {
                    <a class="ms-listrow txn-row" href="@row.EditUrl">
                        <span class="ms-listrow__icon"><ms-icon name="@row.Icon" size="20"></ms-icon></span>
                        <span class="ms-listrow__main">
                            <span class="txn-line">
                                <span class="txn-title">@row.Title</span>
                            </span>
                            <span class="ms-listrow__sub">@row.Subtitle</span>
                        </span>
                        <span class="ms-listrow__amount">
                            <ms-money cents="@row.AmountCents" currency="@currency"></ms-money>
                            <span class="ms-listrow__sub">@MatSplit.Web.Pages.Groups.DetailsModel.RelativeDay(row.Date)</span>
                        </span>
                    </a>
                }
            </div>

            <ms-pagination id="group-transactions-pages"
                           page="@Model.Transactions.Page"
                           page-size="@Model.Transactions.PageSize"
                           total-count="@Model.Transactions.TotalCount"
                           page-url="@Model.TransactionsPageUrl()"></ms-pagination>
        }
    </ms-card>
}
else
{
    <ms-card id="group-members-panel">
        @{
            var mAll = MatSplit.Web.Pages.Groups.DetailsModel.MemberAll;
            var mAdmins = MatSplit.Web.Pages.Groups.DetailsModel.MemberAdmins;
            var mUsers = MatSplit.Web.Pages.Groups.DetailsModel.MemberUsers;
            var mAnon = MatSplit.Web.Pages.Groups.DetailsModel.MemberAnon;
        }
        <div class="txn-toolbar">
            <div class="txn-filter" role="tablist" aria-label="Mitglieder filtern">
                <a class="txn-filter__pill@(Model.ActiveMemberType == mAll ? " is-active" : string.Empty)"
                   href="@Model.MemberTypeUrl(mAll)">Alle</a>
                <a class="txn-filter__pill@(Model.ActiveMemberType == mAdmins ? " is-active" : string.Empty)"
                   href="@Model.MemberTypeUrl(mAdmins)">Admins</a>
                <a class="txn-filter__pill@(Model.ActiveMemberType == mUsers ? " is-active" : string.Empty)"
                   href="@Model.MemberTypeUrl(mUsers)">Benutzer</a>
                <a class="txn-filter__pill@(Model.ActiveMemberType == mAnon ? " is-active" : string.Empty)"
                   href="@Model.MemberTypeUrl(mAnon)">Anonyme</a>
            </div>
            @if (Model.CanManage)
            {
                <ms-button id="members-add" kind="primary" icon="plus" label="Mitglied hinzufügen"
                           href="@memberEditUrl"></ms-button>
            }
        </div>

        @if (Model.Members.Count == 0)
        {
            <ms-empty-state id="group-members-empty" title="Noch keine Mitglieder"
                            text="@(Model.CanManage ? "Nimm ein bestehendes Mitglied auf oder teile den Einladungslink." : "Lade Leute per Link ein, dann kann abgerechnet werden.")"
                            icon="users"
                            action-url="@(Model.CanManage ? memberEditUrl : (Model.CanInvite ? shareUrl : null))"
                            action-label="@(Model.CanManage ? "Mitglied hinzufügen" : "Einladung teilen")"></ms-empty-state>
        }
        else if (Model.FilteredMembers.Count == 0)
        {
            <p class="ms-muted" style="margin: var(--ms-space-3) 0;">Keine Mitglieder in dieser Kategorie.</p>
        }
        else
        {
            <div class="txn-list">
                @foreach (var member in Model.FilteredMembers)
                {
                    var name = member.User?.DisplayName ?? "Unbekannt";
                    var isYou = myUserId != 0 && member.UserId == myUserId;
                    var memberBalance = Model.Balance.Balances.FirstOrDefault(b => b.UserId == member.UserId);
                    <div class="ms-listrow">
                        <ms-avatar name="@name" size="md" you="@isYou"></ms-avatar>
                        <span class="ms-listrow__main">
                            <span class="txn-line">
                                <span class="txn-title">@name @(isYou ? "(du)" : string.Empty)</span>
                                @if (member.ShareFactor != 1)
                                {
                                    <span class="ms-chip">@member.ShareFactor Personen</span>
                                }
                                @if (member.IsGroupAdmin)
                                {
                                    <span class="ms-chip">Admin</span>
                                }
                            </span>
                        </span>
                        <span class="ms-listrow__amount">
                            <ms-money cents="@(memberBalance?.BalanceCents ?? 0)" currency="@currency"
                                      show-sign="true" strong="true"></ms-money>
                        </span>
                        @if (Model.CanManage)
                        {
                            <ms-button id="@($"member-{member.UserId}-edit")" kind="ghost" size="sm"
                                       icon="edit" icon-only="true" label="Mitglied bearbeiten"
                                       href="@($"{memberEditUrl}&userId={member.UserId}")"></ms-button>
                        }
                    </div>
                }
            </div>
        }

        @if (Model.CanInvite)
        {
            <div class="ms-row group-members-actions">
                <ms-button id="group-members-share" kind="secondary" icon="share" label="Einladung teilen"
                           href="@shareUrl"></ms-button>
            </div>
        }
    </ms-card>
}

<style>
    /* Page-scoped hub chrome (pill tabs + transaction list). Only local
       selectors; no shared foundation styles are touched. */

    .group-tabs {
        display: flex;
        align-items: center;
        gap: var(--ms-space-2);
        margin: var(--ms-space-4) 0 var(--ms-space-3);
    }

    .group-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 16px;
        border-radius: var(--ms-radius-pill);
        border: 1px solid var(--ms-primary);
        background: var(--ms-surface);
        color: var(--ms-primary);
        font-weight: 650;
        text-decoration: none;
        transition: background var(--ms-transition), color var(--ms-transition);
    }

    .group-tab:hover {
        background: var(--ms-primary-soft);
    }

    .group-tab.is-active {
        background: var(--ms-primary);
        border-color: var(--ms-primary);
        color: var(--ms-primary-contrast);
    }

    .group-tab.is-active:hover {
        background: var(--ms-primary-hover);
    }

    .group-tabs__tools {
        display: inline-flex;
        align-items: center;
        gap: var(--ms-space-2);
        margin-left: auto;
    }

    .group-tabs__gear {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1px solid var(--ms-border);
        background: var(--ms-surface);
        color: var(--ms-text-soft);
        text-decoration: none;
        transition: background var(--ms-transition), color var(--ms-transition), border-color var(--ms-transition);
    }

    .group-tabs__gear:hover {
        background: var(--ms-primary-soft);
        border-color: var(--ms-primary);
        color: var(--ms-primary);
    }

    .txn-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--ms-space-3);
        flex-wrap: wrap;
        margin-bottom: var(--ms-space-2);
    }

    .txn-filter {
        display: flex;
        gap: var(--ms-space-2);
        flex-wrap: wrap;
    }

    .txn-filter__pill {
        padding: 6px 14px;
        border-radius: var(--ms-radius-pill);
        border: 1px solid var(--ms-border);
        background: var(--ms-surface-3);
        color: var(--ms-text-soft);
        font-size: var(--ms-text-sm);
        font-weight: 600;
        text-decoration: none;
    }

    .txn-filter__pill.is-active {
        background: var(--ms-primary);
        border-color: var(--ms-primary);
        color: var(--ms-primary-contrast);
    }

    .txn-row {
        color: inherit;
        text-decoration: none;
    }

    .txn-row:hover {
        background: var(--ms-surface-2);
    }

    .txn-line {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .txn-title {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--ms-text);
        font-weight: 650;
    }

    .group-members-actions {
        margin-top: var(--ms-space-4);
    }

    /* On phones the tab labels ("Transaktionen", "Mitglieder") make the row too
       wide next to the action icons, so the tabs collapse to icon-only. */
    @@media (max-width: 640px) {
        .group-tab span {
            display: none;
        }

        .group-tab {
            padding: 10px 16px;
        }

        /* Toolbar actions ("Neue Ausgabe" / "Mitglied hinzufügen") shrink to the
           bare "+" icon on phones. */
        .txn-toolbar .ms-btn__label {
            display: none;
        }

        .txn-toolbar .ms-btn {
            padding: 10px 12px;
        }
    }
</style>
