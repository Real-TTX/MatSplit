@page
@using MatSplit.Web.Services.Models
@model MatSplit.Web.Pages.Groups.DetailsModel
@{
    var currency = Model.Group.Currency;
    var myBalanceCents = Model.MyBalance?.BalanceCents ?? 0;
    var myOwedCents = Model.MyBalance?.OwedCents ?? 0;
    var myUserId = Model.MyBalance?.UserId ?? 0;
    var balanceUrl = $"/Groups/Balance?groupId={Model.GroupId}";
    var expenseEditUrl = $"/Groups/Expenses/Edit?groupId={Model.GroupId}";
    var shareUrl = $"/Groups/Share?groupId={Model.GroupId}";
    var historyUrl = $"/Groups/History?groupId={Model.GroupId}";
    var memberEditUrl = $"/Groups/MemberEdit?groupId={Model.GroupId}";
    var editUrl = $"/Groups/Edit?id={Model.GroupId}";
    var transactionsActive = Model.ActiveTab == MatSplit.Web.Pages.Groups.DetailsModel.TabTransactions;
    var membersActive = Model.ActiveTab == MatSplit.Web.Pages.Groups.DetailsModel.TabMembers;

    // The icons of the header bar (SHELL-17): history, the invitation and the settings belong to the whole group,
    // the main action in the accent colour is what the open tab adds: an expense or a member.
    var headerActions = new List<HeaderAction> { new(historyUrl, "history", "Historie") };
    if (Model.CanInvite)
    {
        headerActions.Add(new HeaderAction(shareUrl, "share", "Einladung teilen"));
    }

    if (Model.CanManage)
    {
        headerActions.Add(new HeaderAction(editUrl, "cog", "Gruppe verwalten"));
    }

    if (transactionsActive)
    {
        headerActions.Add(new HeaderAction(expenseEditUrl, "plus", "Neue Ausgabe", Primary: true));
    }
    else if (Model.CanManage)
    {
        headerActions.Add(new HeaderAction(memberEditUrl, "plus", "Mitglied hinzufügen", Primary: true));
    }

    ViewData[LayoutKeys.HeaderActions] = headerActions;
}

@* The balance of the user in one card; tapping it opens the Kontostand sub-page (/Groups/Balance) with the open
   settlements and the balance of each member. *@
<a class="mat-card mat-card--accent ms-balance-hero" id="group-balance-hero"
   href="@balanceUrl" aria-label="Kontostand im Detail ansehen">
    <span class="ms-balance-hero__label">Kontostand</span>
    <span class="ms-balance-hero__amount">
        <ms-money cents="@myBalanceCents" currency="@currency" show-sign="true"></ms-money>
    </span>
    <span class="ms-balance-hero__share">
        Dein Anteil <strong><ms-money cents="@myOwedCents" currency="@currency"></ms-money></strong>
        von <ms-money cents="@Model.Balance.TotalExpensesCents" currency="@currency"></ms-money>
    </span>
    <span class="ms-balance-hero__chart">
        <svg viewBox="0 0 108 46" aria-hidden="true" focusable="false">
            <path d="@Model.BalanceSparkline()" />
        </svg>
    </span>
</a>

<nav class="mat-tabs" aria-label="Gruppenbereiche">
    <a id="group-tab-transaktionen" class="mat-tab@(transactionsActive ? " is-active" : string.Empty)"
       href="@Model.TabUrl(MatSplit.Web.Pages.Groups.DetailsModel.TabTransactions)"
       aria-current="@(transactionsActive ? "page" : null)">
        Transaktionen
    </a>
    <a id="group-tab-mitglieder" class="mat-tab@(membersActive ? " is-active" : string.Empty)"
       href="@Model.TabUrl(MatSplit.Web.Pages.Groups.DetailsModel.TabMembers)"
       aria-current="@(membersActive ? "page" : null)">
        Mitglieder (@Model.Members.Count)
    </a>
</nav>

@if (transactionsActive)
{
    var typeAll = MatSplit.Web.Pages.Groups.DetailsModel.TypeAll;
    var typeExpenses = MatSplit.Web.Pages.Groups.DetailsModel.TypeExpenses;
    var typePayments = MatSplit.Web.Pages.Groups.DetailsModel.TypePayments;
    <section class="mat-list" id="group-transactions" aria-label="Transaktionen">
        <nav class="mat-tabs mat-tabs--pills" aria-label="Nach Typ filtern">
            <a class="mat-tab@(Model.ActiveType == typeAll ? " is-active" : string.Empty)"
               href="@Model.TypeUrl(typeAll)" aria-current="@(Model.ActiveType == typeAll ? "page" : null)">Alle</a>
            <a class="mat-tab@(Model.ActiveType == typeExpenses ? " is-active" : string.Empty)"
               href="@Model.TypeUrl(typeExpenses)" aria-current="@(Model.ActiveType == typeExpenses ? "page" : null)">Ausgaben</a>
            <a class="mat-tab@(Model.ActiveType == typePayments ? " is-active" : string.Empty)"
               href="@Model.TypeUrl(typePayments)" aria-current="@(Model.ActiveType == typePayments ? "page" : null)">Zahlungen</a>
        </nav>

        @if (Model.Transactions.IsEmpty)
        {
            <ms-empty-state id="group-transactions-empty" title="Noch keine Transaktionen"
                            text="Erfasse die erste Ausgabe oder Zahlung, damit die Abrechnung starten kann."
                            icon="expense"
                            action-url="@expenseEditUrl"
                            action-label="Ausgabe erfassen"></ms-empty-state>
        }
        else
        {
            <ul class="mat-itemlist mat-itemlist--inset" aria-label="Transaktionen">
                @foreach (var row in Model.Transactions.Items)
                {
                    <li class="mat-item">
                        <a class="mat-item__main" href="@row.EditUrl">
                            <span class="mat-item__lead"><span class="mat-item__tile"><ms-icon name="@row.Icon"></ms-icon></span></span>
                            <span class="mat-item__body">
                                <span class="mat-item__title">@row.Title</span>
                                <span class="mat-item__text">@row.Subtitle</span>
                            </span>
                            <span class="mat-item__end ms-item-amount">
                                <ms-money cents="@row.AmountCents" currency="@currency"></ms-money>
                                <small class="mat-muted">@MatSplit.Web.Pages.Groups.DetailsModel.RelativeDay(row.Date)</small>
                            </span>
                        </a>
                    </li>
                }
            </ul>

            <ms-pagination id="group-transactions-pages"
                           page="@Model.Transactions.Page"
                           page-size="@Model.Transactions.PageSize"
                           total-count="@Model.Transactions.TotalCount"
                           page-url="@Model.TransactionsPageUrl()"></ms-pagination>
        }
    </section>
}
else
{
    var mAll = MatSplit.Web.Pages.Groups.DetailsModel.MemberAll;
    var mAdmins = MatSplit.Web.Pages.Groups.DetailsModel.MemberAdmins;
    var mUsers = MatSplit.Web.Pages.Groups.DetailsModel.MemberUsers;
    var mAnon = MatSplit.Web.Pages.Groups.DetailsModel.MemberAnon;
    <section class="mat-list" id="group-members-panel" aria-label="Mitglieder">
        <nav class="mat-tabs mat-tabs--pills" aria-label="Mitglieder filtern">
            <a class="mat-tab@(Model.ActiveMemberType == mAll ? " is-active" : string.Empty)"
               href="@Model.MemberTypeUrl(mAll)" aria-current="@(Model.ActiveMemberType == mAll ? "page" : null)">Alle</a>
            <a class="mat-tab@(Model.ActiveMemberType == mAdmins ? " is-active" : string.Empty)"
               href="@Model.MemberTypeUrl(mAdmins)" aria-current="@(Model.ActiveMemberType == mAdmins ? "page" : null)">Admins</a>
            <a class="mat-tab@(Model.ActiveMemberType == mUsers ? " is-active" : string.Empty)"
               href="@Model.MemberTypeUrl(mUsers)" aria-current="@(Model.ActiveMemberType == mUsers ? "page" : null)">Benutzer</a>
            <a class="mat-tab@(Model.ActiveMemberType == mAnon ? " is-active" : string.Empty)"
               href="@Model.MemberTypeUrl(mAnon)" aria-current="@(Model.ActiveMemberType == mAnon ? "page" : null)">Anonyme</a>
        </nav>

        @if (Model.Members.Count == 0)
        {
            <ms-empty-state id="group-members-empty" title="Noch keine Mitglieder"
                            text="@(Model.CanManage ? "Nimm ein bestehendes Mitglied auf oder teile den Einladungslink." : "Lade Leute per Link ein, dann kann abgerechnet werden.")"
                            icon="users"
                            action-url="@(Model.CanManage ? memberEditUrl : (Model.CanInvite ? shareUrl : null))"
                            action-label="@(Model.CanManage ? "Mitglied hinzufügen" : "Einladung teilen")"></ms-empty-state>
        }
        else if (Model.FilteredMembers.Count == 0)
        {
            <p class="mat-muted">Keine Mitglieder in dieser Kategorie.</p>
        }
        else
        {
            <ul class="mat-itemlist mat-itemlist--inset" aria-label="Mitglieder">
                @foreach (var member in Model.FilteredMembers)
                {
                    var name = member.User?.DisplayName ?? "Unbekannt";
                    var isYou = myUserId != 0 && member.UserId == myUserId;
                    var memberBalance = Model.Balance.Balances.FirstOrDefault(b => b.UserId == member.UserId);
                    <li class="mat-item">
                        <div class="mat-item__main">
                            <span class="mat-item__lead"><ms-avatar name="@name" you="@isYou"></ms-avatar></span>
                            <span class="mat-item__body">
                                <span class="mat-item__title">@name @(isYou ? "(du)" : string.Empty)</span>
                                @if (member.ShareFactor != 1 || member.IsGroupAdmin)
                                {
                                    <span class="mat-item__text">
                                        @if (member.IsGroupAdmin)
                                        {
                                            <span class="mat-tag">Admin</span>
                                        }
                                        @if (member.ShareFactor != 1)
                                        {
                                            <span class="mat-tag">@member.ShareFactor Personen</span>
                                        }
                                    </span>
                                }
                            </span>
                            <span class="mat-item__end">
                                <ms-money cents="@(memberBalance?.BalanceCents ?? 0)" currency="@currency"
                                          show-sign="true" strong="true"></ms-money>
                            </span>
                        </div>
                        @if (Model.CanManage)
                        {
                            <span class="mat-item__aside">
                                <ms-button id="@($"member-{member.UserId}-edit")" kind="ghost" size="sm"
                                           icon="edit" icon-only="true" label="Mitglied bearbeiten"
                                           href="@($"{memberEditUrl}&userId={member.UserId}")"></ms-button>
                            </span>
                        }
                    </li>
                }
            </ul>
        }

        @if (Model.CanInvite)
        {
            <ms-actions id="group-members-actions">
                <ms-button id="group-members-share" kind="secondary" icon="share" label="Einladung teilen"
                           href="@shareUrl"></ms-button>
            </ms-actions>
        }
    </section>
}
