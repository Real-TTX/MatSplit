@page
@model MatSplit.Web.Pages.Groups.Expenses.EditModel


<ms-card id="expense-card" title="@(Model.IsExisting ? "Ausgabe bearbeiten" : "Neue Ausgabe")"
         subtitle="@Model.Group.Name" icon="expense">
    <ms-form id="expense-form" columns="2" has-files="true">
        @* Screen 4 "Neue Ausgabe": Titel, Betrag (mit €), Datum, Bezahlt von.
           Die Währung ist durch die Gruppe fix und wird serverseitig gesetzt. *@
        <ms-field id="ef-desc" for="Input.Description" full-width="true"
                  placeholder="z. B. Abendessen im Restaurant"></ms-field>

        <ms-field id="ef-amount" for="Input.Amount" type="money" currency="@Model.Input.Currency"></ms-field>
        <ms-field id="ef-date" for="Input.ExpenseDate" type="date"></ms-field>

        <ms-field id="ef-payer" for="Input.PaidByUserId" type="select"
                  items="Model.MemberOptions" option-label="Bitte wählen"></ms-field>
        <ms-field id="ef-category" for="Input.Category"
                  hint="@Model.CategoryHint" placeholder="z. B. Essen"></ms-field>

        @* "Für wen?" (Aufteilung): Auswahl der Split-Methode, darunter erscheinen
           bei Bedarf die abweichenden Anteile je Mitglied (progressive disclosure). *@
        <h3 class="ef-section">
            <ms-icon name="users"></ms-icon>
            <span>Für wen?</span>
        </h3>

        <fieldset class="mat-field mat-field--full mat-fieldset" id="ef-mode-field">
            <legend class="mat-label" id="ef-mode-label">Aufteilung</legend>
            <div class="mat-options ef-modes">
                @foreach (var option in Model.ShareModeOptions)
                {
                    var optionId = $"ef-mode-{option.Value.ToLowerInvariant()}";
                    <label class="mat-option" for="@optionId">
                        <input type="radio" id="@optionId"
                               name="Input.ShareMode" value="@option.Value"
                               checked="@(string.Equals(Model.Input.ShareMode, option.Value, StringComparison.Ordinal))" />
                        <span>@option.Label</span>
                    </label>
                }
            </div>
            @foreach (var option in Model.ShareModeOptions)
            {
                <span class="mat-hint"
                      data-show-if="Input.ShareMode" data-show-value="@option.Value" hidden>@option.Hint</span>
            }
        </fieldset>

        @if (Model.Input.Shares.Count > 0)
        {
            <p class="mat-hint mat-field--full"
               data-show-if="Input.ShareMode" data-show-value="Equal" hidden>
                Beteiligt sind alle Mitglieder:
                @string.Join(", ", Model.Input.Shares.Select(x => x.ShareFactor > 1
                    ? $"{x.DisplayName} ({x.ShareFactor} Personen)"
                    : x.DisplayName))
            </p>
        }

        @for (var index = 0; index < Model.Input.Shares.Count; index++)
        {
            var line = Model.Input.Shares[index];
            var rowId = $"ef-share-{index}";

            <div class="ef-share-row mat-field--full"
                 data-show-if="Input.ShareMode" data-show-value="Factors,Amounts" hidden>
                @* Explicit name/value: an indexed hidden field bound with for="" resolves to an empty value. *@
                <ms-field id="@($"{rowId}-user")" name="@($"Input.Shares[{index}].UserId")" type="hidden"
                          value="@line.UserId"></ms-field>
                <ms-field id="@($"{rowId}-in")" for="Input.Shares[index].IsIncluded" type="checkbox"
                          label="@line.DisplayName"></ms-field>
                <ms-field id="@($"{rowId}-factor")" for="Input.Shares[index].ShareFactor" type="number"
                          min="1" max="100" step="1"
                          depends-on="Input.ShareMode" depends-value="Factors"></ms-field>
                @* Live preview of this member's share in "Individuelle Anteile" mode,
                   filled by the inline script below (Betrag × Anteil / Summe). *@
                <span class="ef-share-preview" data-currency="@Model.Input.Currency" hidden aria-live="polite"></span>
                <ms-field id="@($"{rowId}-amount")" for="Input.Shares[index].Amount" type="money"
                          currency="@Model.Input.Currency"
                          depends-on="Input.ShareMode" depends-value="Amounts"></ms-field>
            </div>
        }

        @* Live "remaining to distribute" indicator for the fixed-amounts mode,
           filled by the inline script (Gesamtbetrag − Summe der festen Beträge). *@
        <div class="ef-remaining mat-field--full" data-show-if="Input.ShareMode"
             data-show-value="Amounts" data-currency="@Model.Input.Currency" hidden aria-live="polite"></div>

        @if (!Model.IsExisting)
        {
            <hr class="ms-sep mat-field--full" />
            <ms-field id="ef-receipt" name="Receipt" type="file" label="Belegfoto" full-width="true"
                      accept="image/*,application/pdf" capture="environment" data-ms-receipt="true"
                      data-ms-max-mb="@Model.MaxReceiptSizeMb"
                      data-ms-compress="@(Model.CompressReceipts ? "true" : "false")"
                      data-ms-target-kb="@Model.ReceiptTargetKb"
                      hint="@($"Optional: Foto direkt mit der Kamera aufnehmen. Maximal {Model.MaxReceiptSizeMb} MB." + (Model.CompressReceipts ? $" Bilder werden vor dem Upload auf ca. {Model.ReceiptTargetKb} KB verkleinert." : string.Empty))"></ms-field>
        }

        <ms-field id="ef-id" for="Input.Id" type="hidden"></ms-field>

        <ms-button-row id="ef-buttons">
            <ms-button id="ef-save" kind="primary" icon="save" label="Speichern"></ms-button>
            <ms-button id="ef-back" kind="secondary" icon="back" label="Zurück"
                       type="button" href="@Model.ListUrl"></ms-button>
            @if (Model.IsExisting && Model.CanManage)
            {
                <ms-button id="ef-delete" kind="danger" icon="trash" label="Löschen"
                           handler="Delete" confirm="Ausgabe wirklich löschen?"></ms-button>
            }
        </ms-button-row>
    </ms-form>
</ms-card>

@if (Model.IsExisting)
{
    <partial name="_ReceiptPreview" model="Model.ReceiptPreview" />
}
else
{
    <ms-card id="receipt-hint-card" title="Belege" icon="receipt">
        <ms-alert id="receipt-hint" tone="info"
                  text="Weitere Belege können erfasst werden, sobald die Ausgabe gespeichert ist."></ms-alert>
    </ms-card>
}

@section Scripts {
    <script src="~/js/receipt-capture.js" asp-append-version="true" defer></script>
    <script>
        // Live preview of each member's share in "Individuelle Anteile" mode:
        // Betrag × Anteil / Summe(Anteile der Beteiligten). Display only – the
        // server does the exact cent split on save.
        (function () {
            var form = document.getElementById('expense-form');
            if (!form) { return; }

            var amountInput = form.querySelector('[name="Input.Amount"]');
            var rows = Array.prototype.slice.call(form.querySelectorAll('.ef-share-row'));
            if (!rows.length) { return; }

            function mode() {
                var checked = form.querySelector('input[name="Input.ShareMode"]:checked');
                return checked ? checked.value : '';
            }

            function num(value) {
                var n = parseFloat(String(value == null ? '' : value).replace(',', '.'));
                return isNaN(n) ? 0 : n;
            }

            function fmt(value, currency) {
                try {
                    return value.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + currency;
                } catch (e) {
                    return value.toFixed(2).replace('.', ',') + ' ' + currency;
                }
            }

            function fmtNum(value) {
                try {
                    return value.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                } catch (e) {
                    return value.toFixed(2).replace('.', ',');
                }
            }

            function parts(row) {
                return {
                    include: row.querySelector('input[type="checkbox"][name$=".IsIncluded"]'),
                    factor: row.querySelector('[name$=".ShareFactor"]'),
                    amount: row.querySelector('[name$=".Amount"]'),
                    apply: row.querySelector('.ef-apply'),
                    preview: row.querySelector('.ef-share-preview')
                };
            }

            var remainingEl = form.querySelector('.ef-remaining');
            var currency = (remainingEl && remainingEl.getAttribute('data-currency')) || 'EUR';

            // "Feste Beträge": a small "Rest übernehmen" button per member fills the
            // open remainder into that field with one tap (see recalc for when it
            // shows). Built once here so the tag helper stays untouched.
            rows.forEach(function (row) {
                var p = parts(row);
                if (!p.amount || p.apply) { return; }

                var moneyField = p.amount.closest('.mat-field') || p.amount;
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'mat-btn mat-btn--ghost mat-btn--sm ef-apply';
                btn.hidden = true;
                btn.textContent = 'Rest';
                btn.addEventListener('click', function () {
                    var rem = parseFloat(btn.getAttribute('data-ms-remaining') || '0');
                    if (!(rem > 0)) { return; }
                    // Invariant dot: site.js keeps money fields dot-separated.
                    p.amount.value = rem.toFixed(2);
                    p.amount.dispatchEvent(new Event('input', { bubbles: true }));
                    p.amount.dispatchEvent(new Event('change', { bubbles: true }));
                    p.amount.focus();
                });
                moneyField.parentNode.insertBefore(btn, moneyField);
            });

            function recalc() {
                var m = mode();
                var factorsMode = m === 'Factors';
                var amountsMode = m === 'Amounts';
                var total = num(amountInput ? amountInput.value : 0);

                var factorSum = 0;
                var amountSum = 0;
                rows.forEach(function (row) {
                    var p = parts(row);
                    if (!p.include || !p.include.checked) { return; }
                    if (p.factor) { factorSum += Math.max(0, parseInt(p.factor.value, 10) || 0); }
                    if (p.amount) { amountSum += num(p.amount.value); }
                });

                var remaining = total - amountSum;

                rows.forEach(function (row) {
                    var p = parts(row);
                    var included = p.include && p.include.checked;

                    // "Individuelle Anteile": per-person computed share preview.
                    if (p.preview) {
                        if (factorsMode && included && p.factor && factorSum > 0 && total > 0) {
                            var f = Math.max(0, parseInt(p.factor.value, 10) || 0);
                            p.preview.textContent = fmt(total * f / factorSum, currency);
                            p.preview.hidden = false;
                        } else {
                            p.preview.textContent = '';
                            p.preview.hidden = true;
                        }
                    }

                    // "Feste Beträge": show the open remainder as a placeholder hint
                    // and offer a one-tap "Rest übernehmen" button for empty fields.
                    if (p.amount) {
                        var empty = (p.amount.value || '').trim() === '';
                        var canApply = amountsMode && included && empty && remaining > 0.005;

                        if (amountsMode) {
                            p.amount.setAttribute('placeholder', canApply ? fmtNum(remaining) : '0,00');
                        }

                        if (p.apply) {
                            p.apply.hidden = !canApply;
                            if (canApply) {
                                var label = fmtNum(remaining) + ' ' + currency + ' übernehmen';
                                p.apply.setAttribute('data-ms-remaining', remaining.toFixed(2));
                                p.apply.setAttribute('title', label);
                                p.apply.setAttribute('aria-label', label);
                            }
                        }
                    }
                });

                if (remainingEl) {
                    remainingEl.classList.remove('is-ok', 'is-open', 'is-over');
                    if (amountsMode && total > 0) {
                        if (Math.abs(remaining) < 0.005) {
                            remainingEl.textContent = 'Alles verteilt.';
                            remainingEl.classList.add('is-ok');
                        } else if (remaining > 0) {
                            remainingEl.textContent = 'Noch zu verteilen: ' + fmtNum(remaining) + ' ' + currency;
                            remainingEl.classList.add('is-open');
                        } else {
                            remainingEl.textContent = fmtNum(-remaining) + ' ' + currency + ' zu viel verteilt';
                            remainingEl.classList.add('is-over');
                        }
                    } else {
                        remainingEl.textContent = '';
                    }
                }
            }

            form.addEventListener('input', recalc);
            form.addEventListener('change', recalc);
            recalc();
        })();
    </script>
}
