@page
@model MatSplit.Web.Pages.Groups.Expenses.IndexModel


@* Mobile-only screen head (Screen 3 "Letzte Ausgaben"): title + round orange add button. *@
<div class="ms-expenses-mhead">
    <div class="ms-screen-head">
        <h1 class="ms-screen-title">Ausgaben</h1>
        <a class="ms-screen-head__action" href="@($"/Groups/Expenses/Edit?groupId={Model.GroupId}")" aria-label="Neue Ausgabe">
            <ms-icon name="plus" size="22"></ms-icon>
        </a>
    </div>
</div>

<ms-list id="expenses" title="Ausgaben" subtitle="@($"Alle Ausgaben der Gruppe {Model.Group.Name}")"
         icon="expense" count="@Model.Result.TotalCount">

    <ms-toolbar id="expenses-filter"
                action="/Groups/Expenses"
                reset-url="@Model.ListUrl"
                preserve="groupId"
                auto-submit-text="true">
        <ms-field id="expenses-search" name="search" type="search" label="Suche"
                  value="@Model.Search" placeholder="Beschreibung oder Kategorie"></ms-field>
        <ms-field id="expenses-payer" name="payerUserId" type="select" label="Bezahlt von"
                  items="Model.MemberOptions" option-label="Alle"></ms-field>
        <ms-field id="expenses-from" name="fromDate" type="date" label="Von"
                  value="@Model.FromDate?.ToString("yyyy-MM-dd")"></ms-field>
        <ms-field id="expenses-to" name="toDate" type="date" label="Bis"
                  value="@Model.ToDate?.ToString("yyyy-MM-dd")"></ms-field>
        <ms-field id="expenses-sort" name="sort" type="select" label="Sortierung"
                  items="Model.SortOptions"></ms-field>
    </ms-toolbar>

    @if (Model.CanManage)
    {
        @* Form owner for the row checkboxes: the bulk delete button lives in ms-actions. *@
        <ms-form id="expenses-bulk" action="@Model.ListUrl" handler="DeleteSelected"
                 validation-summary="none"></ms-form>
    }

    @* Mobile card rendering (Screen 3 "Letzte Ausgaben"): same rows as the desktop
       table below, the style block toggles which one shows at the 900px breakpoint.
       Icon circle + description + payer, amount + relative date on the right; the
       whole row links to the edit page (delete lives there per the CRUD guideline). *@
    @if (Model.Rows.Count > 0)
    {
        <ms-card id="expenses-cards" class="ms-expenses-cards">
            @foreach (var row in Model.Rows)
            {
                <a class="ms-listrow" href="@($"/Groups/Expenses/Edit?groupId={Model.GroupId}&id={row.Id}")">
                    <span class="ms-listrow__icon">
                        <ms-icon name="@(row.ReceiptCount > 0 ? "receipt" : "expense")" size="20"></ms-icon>
                    </span>
                    <span class="ms-listrow__main">
                        <strong>@row.Description</strong>
                        <span class="ms-listrow__sub">@row.PaidByName</span>
                    </span>
                    <span class="ms-listrow__amount">
                        <ms-money cents="@row.AmountCents" currency="@row.Currency"></ms-money>
                        <span class="ms-listrow__sub">@RelativeDate(row.ExpenseDate)</span>
                    </span>
                </a>
            }
        </ms-card>
    }

    <ms-table id="expenses-table" caption="Ausgaben der Gruppe">
        <thead>
            <tr>
                @if (Model.CanManage)
                {
                    <th scope="col"><span class="ms-visually-hidden">Auswahl</span></th>
                }
                <th scope="col">Datum</th>
                <th scope="col">Beschreibung</th>
                <th scope="col" class="ms-num">Betrag</th>
                <th scope="col">Bezahlt von</th>
                <th scope="col">Beteiligte</th>
                <th scope="col">Beleg</th>
                <th scope="col"><span class="ms-visually-hidden">Aktionen</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    @if (Model.CanManage)
                    {
                        <td data-label="Auswahl">
                            <input type="checkbox" class="ms-checkbox" form="expenses-bulk"
                                   name="selectedIds" value="@row.Id"
                                   id="@($"expense-{row.Id}-select")"
                                   aria-label="@($"{row.Description} auswählen")" />
                        </td>
                    }
                    <td data-label="Datum">@row.ExpenseDate.ToString("dd.MM.yyyy")</td>
                    <td data-label="Beschreibung">
                        @row.Description
                        @if (!string.IsNullOrWhiteSpace(row.Category))
                        {
                            <span class="ms-chip">@row.Category</span>
                        }
                    </td>
                    <td data-label="Betrag" class="ms-num">
                        <ms-money cents="@row.AmountCents" currency="@row.Currency"></ms-money>
                    </td>
                    <td data-label="Bezahlt von">@row.PaidByName</td>
                    <td data-label="Beteiligte">
                        <span class="ms-chip">@row.ParticipantCount</span>
                        <span class="ms-muted">@row.Participants</span>
                    </td>
                    <td data-label="Beleg">
                        @if (row.ReceiptCount > 0)
                        {
                            <ms-icon name="receipt" label="@($"{row.ReceiptCount} Beleg(e)")"></ms-icon>
                        }
                        else
                        {
                            <span class="ms-muted">&ndash;</span>
                        }
                    </td>
                    <td data-label="Aktionen">
                        <div class="ms-table__rowactions">
                            <ms-button id="@($"expense-{row.Id}-edit")" kind="ghost" size="sm"
                                       icon="edit" icon-only="true" label="Bearbeiten"
                                       href="@($"/Groups/Expenses/Edit?groupId={Model.GroupId}&id={row.Id}")"></ms-button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
        @if (Model.Rows.Count > 0)
        {
            <tfoot>
                <tr>
                    @if (Model.CanManage)
                    {
                        <td></td>
                    }
                    <td data-label="Summe" colspan="2"><strong>Summe dieser Seite</strong></td>
                    <td data-label="Betrag" class="ms-num">
                        <ms-money cents="@Model.PageTotalCents" currency="@Model.Currency" strong="true"></ms-money>
                    </td>
                    <td data-label="Gesamt" colspan="4">
                        <span class="ms-muted">Gesamt in der Gruppe:</span>
                        <ms-money cents="@Model.GroupTotalCents" currency="@Model.Currency"></ms-money>
                    </td>
                </tr>
            </tfoot>
        }
    </ms-table>

    @if (Model.Result.TotalCount == 0)
    {
        <ms-empty-state id="expenses-empty" title="Noch keine Ausgaben"
                        text="Trage die erste Ausgabe ein, damit die Abrechnung starten kann."
                        icon="expense"
                        action-url="@($"/Groups/Expenses/Edit?groupId={Model.GroupId}")"
                        action-label="Ausgabe erfassen"></ms-empty-state>
    }

    <ms-pagination id="expenses-pager"
                   page="@Model.Result.Page"
                   page-size="@Model.Result.PageSize"
                   total-count="@Model.Result.TotalCount"
                   page-url="@($"{Model.ListUrl}{Model.FilterQuery}&page={{0}}")"></ms-pagination>

    <ms-actions id="expenses-actions">
        <ms-button id="expenses-new" kind="primary" icon="plus" label="Neue Ausgabe"
                   href="@($"/Groups/Expenses/Edit?groupId={Model.GroupId}")"></ms-button>
        <ms-button id="expenses-export" kind="secondary" icon="download" label="Export CSV"
                   href="@Model.ExportUrl"></ms-button>
        <ms-button id="expenses-balance" kind="secondary" icon="balance" label="Kontostand"
                   href="@($"/Groups/Balance?groupId={Model.GroupId}")"></ms-button>
        @if (Model.CanManage && Model.Rows.Count > 0)
        {
            <ms-button id="expenses-delete" kind="danger" icon="trash" label="Auswahl löschen"
                       form="expenses-bulk"
                       form-action="@($"{Model.ListUrl}&handler=DeleteSelected")"
                       confirm="Ausgewählte Ausgaben wirklich löschen?"></ms-button>
        }
    </ms-actions>
</ms-list>

@functions {
    // Relative day label for the mobile rows (Heute / Gestern / date), matching
    // the mockup's "Letzte Ausgaben" time column. Presentation only.
    private static string RelativeDate(DateTime date)
    {
        var day = date.Date;
        var today = DateTime.UtcNow.Date;

        if (day == today)
        {
            return "Heute";
        }

        if (day == today.AddDays(-1))
        {
            return "Gestern";
        }

        return day.ToString("dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture);
    }
}

<style>
    /* Expenses list (Screen 3 "Letzte Ausgaben"): the .ms-listrow cards are the
       mobile view (free content inside .ms-list__free), the ms-table stays the
       desktop view. Both render the same rows; this block toggles which one
       shows at the 900px breakpoint and only targets this page's own markup. */
    .ms-expenses-mhead {
        display: none;
    }

    #expenses > .ms-list__free {
        display: none;
    }

    #expenses a.ms-listrow {
        color: var(--ms-text);
        text-decoration: none;
        border-radius: var(--ms-radius);
    }

    @@media (max-width: 900px) {
        .ms-expenses-mhead {
            display: block;
        }

        #expenses > .ms-list__free {
            display: block;
        }

        /* Desktop chrome the cards replace: the in-list heading, the table and
           the bottom actions (add lives in the round + above; export and bulk
           delete stay desktop-only power tools). */
        #expenses > .ms-list__head,
        #expenses #expenses-table-wrap,
        #expenses #expenses-actions {
            display: none;
        }

        #expenses a.ms-listrow:hover {
            background: var(--ms-surface-2);
            text-decoration: none;
        }
    }
</style>
