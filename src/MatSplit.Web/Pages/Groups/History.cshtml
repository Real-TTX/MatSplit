@page
@model MatSplit.Web.Pages.Groups.HistoryModel

<partial name="_GroupNav" model="new MatSplit.Web.Pages.Groups.GroupNav(Model.GroupId, MatSplit.Web.Pages.Groups.GroupNav.History, Model.CanManage)" />

<ms-list id="history" title="Aktivitäten" subtitle="Alle Änderungen dieser Gruppe"
         icon="activity" count="@Model.Result.TotalCount">

    <ms-toolbar id="history-filter"
                action="/Groups/History"
                reset-url="@($"/Groups/History?groupId={Model.GroupId}")"
                preserve="groupId,filter"
                auto-submit-text="true">
        <ms-field id="history-search" name="search" type="search" label="Suche"
                  value="@Model.Search" placeholder="Text, Typ oder Person"></ms-field>
        <ms-field id="history-action" name="action" type="select" label="Aktion"
                  items="Model.ActionOptions" option-label="Alle"></ms-field>
        <ms-field id="history-from" name="fromDate" type="date" label="Von"
                  value="@Model.FromDate?.ToString("yyyy-MM-dd")"></ms-field>
        <ms-field id="history-to" name="toDate" type="date" label="Bis"
                  value="@Model.ToDate?.ToString("yyyy-MM-dd")"></ms-field>
        <ms-field id="history-sort" name="sort" type="select" label="Sortierung"
                  items="Model.SortOptions"></ms-field>
    </ms-toolbar>

    <div class="ms-pills" aria-label="Aktivitäten filtern">
        <a class="ms-pill @(Model.ActiveFilter == MatSplit.Web.Pages.Groups.HistoryModel.FilterAll ? "is-active" : null)"
           href="@Model.BuildFilterUrl(MatSplit.Web.Pages.Groups.HistoryModel.FilterAll)"
           aria-current="@(Model.ActiveFilter == MatSplit.Web.Pages.Groups.HistoryModel.FilterAll ? "page" : null)">Alle</a>
        <a class="ms-pill @(Model.ActiveFilter == MatSplit.Web.Pages.Groups.HistoryModel.FilterExpenses ? "is-active" : null)"
           href="@Model.BuildFilterUrl(MatSplit.Web.Pages.Groups.HistoryModel.FilterExpenses)"
           aria-current="@(Model.ActiveFilter == MatSplit.Web.Pages.Groups.HistoryModel.FilterExpenses ? "page" : null)">Ausgaben</a>
        <a class="ms-pill @(Model.ActiveFilter == MatSplit.Web.Pages.Groups.HistoryModel.FilterPayments ? "is-active" : null)"
           href="@Model.BuildFilterUrl(MatSplit.Web.Pages.Groups.HistoryModel.FilterPayments)"
           aria-current="@(Model.ActiveFilter == MatSplit.Web.Pages.Groups.HistoryModel.FilterPayments ? "page" : null)">Zahlungen</a>
        <a class="ms-pill @(Model.ActiveFilter == MatSplit.Web.Pages.Groups.HistoryModel.FilterJoins ? "is-active" : null)"
           href="@Model.BuildFilterUrl(MatSplit.Web.Pages.Groups.HistoryModel.FilterJoins)"
           aria-current="@(Model.ActiveFilter == MatSplit.Web.Pages.Groups.HistoryModel.FilterJoins ? "page" : null)">Beitritte</a>
    </div>

    @if (Model.Entries.Count > 0)
    {
        <div class="ms-feed">
            @foreach (var entry in Model.Entries)
            {
                var actor = MatSplit.Web.Pages.Groups.HistoryModel.ActorName(entry);
                var icon = MatSplit.Web.Pages.Groups.HistoryModel.FeedIcon(entry);
                var title = MatSplit.Web.Pages.Groups.HistoryModel.FeedTitle(entry);
                var money = MatSplit.Web.Pages.Groups.HistoryModel.FeedAmount(entry);

                <div class="ms-feed__item">
                    <span class="ms-feed__avatar">
                        @if (icon is not null)
                        {
                            <ms-icon name="@icon" size="22"></ms-icon>
                        }
                        else
                        {
                            <ms-avatar name="@actor" size="md"></ms-avatar>
                        }
                    </span>
                    <span class="ms-feed__text">
                        <strong>@actor</strong> @MatSplit.Web.Pages.Groups.HistoryModel.FeedSentence(entry)
                        @if (title is not null)
                        {
                            <span class="ms-feed__title">@title</span>
                        }
                        <span class="ms-feed__time">@MatSplit.Web.Pages.Groups.HistoryModel.RelativeTime(entry.CreateDate)</span>
                    </span>
                    @if (money is not null)
                    {
                        <span class="ms-feed__amount">
                            <ms-money cents="@money.Cents" currency="@money.Currency"></ms-money>
                        </span>
                    }
                </div>
            }
        </div>
    }

    @if (Model.Result.TotalCount == 0)
    {
        <ms-empty-state id="history-empty" title="Noch keine Einträge"
                        text="Sobald Ausgaben, Zahlungen oder Mitglieder geändert werden, entsteht hier die Aktivität."
                        icon="activity"
                        action-url="@($"/Groups/Expenses?groupId={Model.GroupId}")"
                        action-label="Zu den Ausgaben"></ms-empty-state>
    }

    <ms-pagination id="history-pager"
                   page="@Model.Result.Page"
                   page-size="@Model.Result.PageSize"
                   total-count="@Model.Result.TotalCount"
                   page-url="@Model.BuildPageUrl()"></ms-pagination>

    <ms-actions id="history-actions">
        <ms-button id="history-balance" kind="secondary" icon="balance" label="Kontostand"
                   href="@($"/Groups/Balance?groupId={Model.GroupId}")"></ms-button>
        <ms-button id="history-payments" kind="secondary" icon="paypal" label="Zahlungen"
                   href="@($"/Groups/Payments?groupId={Model.GroupId}")"></ms-button>
        <ms-button id="history-expenses" kind="secondary" icon="expense" label="Ausgaben"
                   href="@($"/Groups/Expenses?groupId={Model.GroupId}")"></ms-button>
    </ms-actions>
</ms-list>

@* The desktop toolbar (search, date range, sort) is a desktop only addition;
   on mobile the category pills replace it to match the mockup. *@
<style>
    @@media (max-width: 900px) {
        #history-filter {
            display: none;
        }
    }
</style>
