@page
@model MatSplit.Web.Pages.ViewModel
@{
    var tabTx = MatSplit.Web.Pages.ViewModel.TabTransactions;
    var tabMem = MatSplit.Web.Pages.ViewModel.TabMembers;
    var tAll = MatSplit.Web.Pages.ViewModel.TypeAll;
    var tExp = MatSplit.Web.Pages.ViewModel.TypeExpenses;
    var tPay = MatSplit.Web.Pages.ViewModel.TypePayments;
    var onTx = Model.ActiveTab == tabTx;
}

@if (!Model.Found)
{
    <ms-card id="ro-missing" title="Nicht verfügbar" icon="link">
        <p class="mat-muted">Dieser Nur-Lese-Link ist ungültig oder wurde deaktiviert.</p>
    </ms-card>
}
else
{
    @* The public read-only view: the figures of the group, two tabs (transactions, members) and the type filter. *@
    <div class="mat-stack">
        <div class="mat-grid mat-grid--3">
            <div class="mat-card">
                <div class="mat-card__body mat-stat">
                    <span class="mat-stat__label">Ausgaben</span>
                    <span class="mat-stat__value"><ms-money cents="@Model.Balance.TotalExpensesCents" currency="@Model.Currency"></ms-money></span>
                </div>
            </div>
            <div class="mat-card">
                <div class="mat-card__body mat-stat">
                    <span class="mat-stat__label">Zahlungen</span>
                    <span class="mat-stat__value"><ms-money cents="@Model.Balance.TotalPaymentsCents" currency="@Model.Currency"></ms-money></span>
                </div>
            </div>
            <div class="mat-card mat-card--accent">
                <div class="mat-card__body mat-stat">
                    <span class="mat-stat__label">Offener Ausgleich</span>
                    <span class="mat-stat__value"><ms-money cents="@Model.OpenSettlementCents" currency="@Model.Currency"></ms-money></span>
                </div>
            </div>
        </div>

        <nav class="mat-tabs" aria-label="Ansicht">
            <a class="mat-tab@(onTx ? " is-active" : string.Empty)" href="@Model.TabUrl(tabTx)"
               aria-current="@(onTx ? "page" : null)">Transaktionen</a>
            <a class="mat-tab@(!onTx ? " is-active" : string.Empty)" href="@Model.TabUrl(tabMem)"
               aria-current="@(!onTx ? "page" : null)">Mitglieder (@Model.Members.Count)</a>
        </nav>

        @if (onTx)
        {
            <section class="mat-list" id="ro-transactions" aria-label="Transaktionen">
                <nav class="mat-tabs mat-tabs--pills" aria-label="Nach Typ filtern">
                    <a class="mat-tab@(Model.ActiveType == tAll ? " is-active" : string.Empty)"
                       href="@Model.TypeUrl(tAll)" aria-current="@(Model.ActiveType == tAll ? "page" : null)">Alle</a>
                    <a class="mat-tab@(Model.ActiveType == tExp ? " is-active" : string.Empty)"
                       href="@Model.TypeUrl(tExp)" aria-current="@(Model.ActiveType == tExp ? "page" : null)">Ausgaben</a>
                    <a class="mat-tab@(Model.ActiveType == tPay ? " is-active" : string.Empty)"
                       href="@Model.TypeUrl(tPay)" aria-current="@(Model.ActiveType == tPay ? "page" : null)">Zahlungen</a>
                </nav>

                @if (Model.Transactions.Count == 0)
                {
                    <ms-empty-state id="ro-empty" title="Noch keine Transaktionen"
                                    text="In dieser Ansicht gibt es noch nichts zu sehen." icon="expense"></ms-empty-state>
                }
                else
                {
                    <ul class="mat-itemlist mat-itemlist--inset" aria-label="Transaktionen">
                        @foreach (var row in Model.Transactions)
                        {
                            <li class="mat-item">
                                <div class="mat-item__main">
                                    <span class="mat-item__lead"><span class="mat-item__tile"><ms-icon name="@row.Icon"></ms-icon></span></span>
                                    <span class="mat-item__body">
                                        <span class="mat-item__title">@row.Title</span>
                                        <span class="mat-item__text">@row.Subtitle</span>
                                    </span>
                                    <span class="mat-item__end ms-item-amount">
                                        <ms-money cents="@row.AmountCents" currency="@Model.Currency"></ms-money>
                                        <small class="mat-muted">@MatSplit.Web.Pages.Groups.DetailsModel.RelativeDay(row.Date)</small>
                                    </span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
        else
        {
            <ms-card id="ro-members" title="Kontostand pro Mitglied" icon="users"
                     subtitle="Positiv bedeutet: bekommt Geld zurück." flush="true">
                <ul class="mat-itemlist" aria-label="Kontostand pro Mitglied">
                    @foreach (var b in Model.Balance.Balances)
                    {
                        <li class="mat-item">
                            <div class="mat-item__main">
                                <span class="mat-item__lead"><ms-avatar name="@b.DisplayName"></ms-avatar></span>
                                <span class="mat-item__body"><span class="mat-item__title">@b.DisplayName</span></span>
                                <span class="mat-item__end">
                                    <ms-money cents="@b.BalanceCents" currency="@Model.Currency" show-sign="true" strong="true"></ms-money>
                                </span>
                            </div>
                        </li>
                    }
                </ul>
            </ms-card>

            <ms-card id="ro-settlements" title="Ausgleichszahlungen" icon="balance"
                     subtitle="Minimale Überweisungen, damit alle bei null stehen." flush="@(Model.Balance.Settlements.Count > 0)">
                @if (Model.Balance.Settlements.Count == 0)
                {
                    <ms-alert id="ro-settled" tone="success" title="Alles ausgeglichen"
                              text="Zurzeit schuldet niemand jemandem Geld."></ms-alert>
                }
                else
                {
                    <ul class="mat-itemlist" aria-label="Ausgleichszahlungen">
                        @foreach (var s in Model.Balance.Settlements)
                        {
                            <li class="mat-item">
                                <div class="mat-item__main">
                                    <span class="mat-item__lead"><span class="mat-item__tile"><ms-icon name="ausgleich"></ms-icon></span></span>
                                    <span class="mat-item__body"><span class="mat-item__title">@s.FromDisplayName → @s.ToDisplayName</span></span>
                                    <span class="mat-item__end">
                                        <ms-money cents="@s.AmountCents" currency="@Model.Currency" strong="true"></ms-money>
                                    </span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </ms-card>
        }
    </div>
}
